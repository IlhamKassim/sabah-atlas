# Copy to .env (never committed). Everything is optional for the read-only atlas;
# the AI Analyst and night-lights pipeline need the keys below.

# --- Database (local Docker default) ---
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5433/atlas

# --- AI Analyst: Azure OpenAI via Microsoft Foundry ---
# Endpoint looks like https://<resource>.openai.azure.com/ (or your Foundry project's
# Azure OpenAI endpoint). Deployment names are the names you gave the deployments.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Either https://<name>.openai.azure.com (classic, uses the api-version below)
# or https://<name>.openai.azure.com/openai/v1 (Foundry v1 API, api-version ignored)
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment names as shown in Foundry → Deployments (not the model names, unless you kept them).
# Final answers, e.g. gpt-4.1 or gpt-4o
ATLAS_LLM_DEPLOYMENT=
# Optional smaller model for routing and eval grading, e.g. gpt-4.1-mini
ATLAS_LLM_ROUTER_DEPLOYMENT=
# Optional stronger model for the 27 district briefs (defaults to ATLAS_LLM_DEPLOYMENT)
ATLAS_BRIEF_DEPLOYMENT=
# Embeddings for semantic retrieval, e.g. text-embedding-3-small (1536 dims)
ATLAS_EMBED_DEPLOYMENT=

# Alternative providers (the adapter picks the first configured):
# ANTHROPIC_API_KEY=
# ATLAS_LLM_PROVIDER=azure | anthropic | openai_compatible
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1   # e.g. Ollama

# --- Night lights: NASA Earthdata (free) ---
# https://urs.earthdata.nasa.gov -> Profile -> Generate Token
EARTHDATA_TOKEN=

# --- Web ---
ATLAS_API_URL=http://localhost:8000
NEXT_PUBLIC_ATLAS_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Azure deploy (infra/azure/deploy.sh) ---
ATLAS_ALERT_EMAIL=
ATLAS_MONTHLY_BUDGET=50
ATLAS_LOCATION=southeastasia
ATLAS_RG=atlas-ekonomi-sabah
# Public address if you bind a custom domain; blank = the Container Apps URL.
ATLAS_SITE_URL=
# Google Analytics 4 measurement ID (G-...); blank = no analytics tag.
ATLAS_GA_ID=
