# Copy to .env (never committed). Everything is optional for the read-only atlas;
# the AI Analyst and night-lights pipeline need the keys below.

# --- Database (local Docker default) ---
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5433/atlas

# --- AI Analyst: Azure OpenAI via Microsoft Foundry ---
# Endpoint looks like https://<resource>.openai.azure.com/ (or your Foundry project's
# Azure OpenAI endpoint). Deployment names are the names you gave the deployments.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
ATLAS_LLM_DEPLOYMENT=            # e.g. gpt-4.1 or gpt-4o (final answers)
ATLAS_LLM_ROUTER_DEPLOYMENT=     # optional smaller model for routing, e.g. gpt-4.1-mini
ATLAS_EMBED_DEPLOYMENT=          # e.g. text-embedding-3-small

# Alternative providers (the adapter picks the first configured):
# ANTHROPIC_API_KEY=
# ATLAS_LLM_PROVIDER=azure | anthropic | openai_compatible
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1   # e.g. Ollama

# --- Night lights: NASA Earthdata (free) ---
# https://urs.earthdata.nasa.gov -> Profile -> Generate Token
EARTHDATA_TOKEN=

# --- Web ---
ATLAS_API_URL=http://localhost:8000
NEXT_PUBLIC_ATLAS_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
